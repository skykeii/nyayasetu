# Copy to .env.local. Everything is optional for local demos; see README.md.

# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required on Vercel: sign-in is refused there if SESSION_SECRET is missing.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Groq AI. Without a key, every feature uses its deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3

# Supabase persistence. Server-side only; never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
